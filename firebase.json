{
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      ".firebase/**",
      ".git/**",
      "firebase.json",
      "dist/**",
      "src/**"
    ]
  },
  "hosting": {
    "site": "hammer-and-code",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/webhook/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
