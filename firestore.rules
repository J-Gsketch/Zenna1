rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownTenant(id) { return signedIn() && request.auth.uid == id; }

    match /tenants/{tenantId} {
      allow read, write: if ownTenant(tenantId);
      match /settings/{settingId} {
        allow read, write: if ownTenant(tenantId);
      }
    }
    match /leads/{leadId} {
      allow read: if signedIn() && resource.data.tenant_id == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.tenant_id == request.auth.uid
        && (resource == null || resource.data.tenant_id == request.auth.uid);
    }
    match /calls/{callId} {
      allow read: if signedIn() && resource.data.tenant_id == request.auth.uid;
      allow write: if false;
    }
    match /usage/{usageId} {
      allow read: if signedIn() && resource.data.tenant_id == request.auth.uid;
      allow write: if false;
    }
  }
}
