# =================================================================
# ZENNA PLATFORM ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. SERVER & SYSTEM SETTINGS
# -----------------------------------------------------------------
PORT=3000
NODE_ENV=production
SECRET_KEY=zenna_super_secret_jwt_key_2026

# -----------------------------------------------------------------
# 2. BUSINESS & OPERATOR CREDENTIALS (DEFAULT FALLBACK ONLY)
# -----------------------------------------------------------------
# NOTE: Zenna is multi-tenant. Each customer configures their own business
# name, owner, booking link, and callout fee via the onboarding dashboard
# (see docs/ONBOARDING.md). These env vars are only used as a fallback
# default before a tenant has configured their account.
BUSINESS_NAME="Your Business"
OWNER_NAME="Owner"
OWNER_PHONE=""
BOOKING_LINK="https://zenna.au/book"
CALLOUT_FEE="$150"

# -----------------------------------------------------------------
# 3. AI PROVIDER KEYS (GEMINI & ANTHROPIC)
# -----------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Anthropic Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------
# 4. TELEPHONY & SMS (TWILIO INTEGRATION)
# -----------------------------------------------------------------
# Get SID & Auth Token from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+61291234567

# -----------------------------------------------------------------
# 5. PAYMENT & INTEGRATION LINKS
# -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEPOSIT_PAYMENT_LINK=https://buy.stripe.com/...
GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F

# -----------------------------------------------------------------
# 6. SUBSCRIPTION PLAN PRICING (see features/copilot/plans/)
# -----------------------------------------------------------------
# Stripe Price IDs for each plan/interval. Create these Products & Prices
# in the Stripe Dashboard, then paste the Price IDs (price_...) here.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# -----------------------------------------------------------------
# 7. MONITORING & ALERTS
# -----------------------------------------------------------------
# Optional: incoming webhook URL to receive VIP lead / critical error alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
