    "@remotion/cli": "^4.0.506",
    "@remotion/google-fonts": "^4.0.506",
    "@remotion/player": "^4.0.506",
    "@remotion/renderer": "^4.0.507",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "postcss": "^8.5.25",
    "puppeteer": "^25.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "remotion": "^4.0.506",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.5.0",
    "twilio": "^6.0.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.5.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
